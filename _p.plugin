[Argument]
Weather.Provider=input,ColorfulClouds,tag=Weather.Provider, desc=Weather.Provider
NextHour.Provider=input,ColorfulClouds,tag=NextHour.Provider, desc=NextHour.Provider
AirQuality.Calculate.Algorithm=input,EU_EAQI,tag=AirQuality.Calculate.Algorithm, desc=AirQuality.Calculate.Algorithm
API.ColorfulClouds.Token=input,,tag=API.ColorfulClouds.Token, desc=API.ColorfulClouds.Token
API.QWeather.Host=input,devapi.qweather.com,tag=API.QWeather.Host, desc=API.QWeather.Host
API.QWeather.Token=input,,tag=API.QWeather.Token, desc=API.QWeather.Token
API.WAQI.Token=input,,tag=API.WAQI.Token, desc=API.WAQI.Token
Storage=input,Argument,tag=Storage, desc=Storage
LogLevel=input,WARN,tag=LogLevel, desc=LogLevel
MY=switch,"false","true",tag=MY, desc=MY
DT=switch,"false","true",tag=DT, desc=DT
FX=switch,"false","true",tag=FX, desc=FX
PRGG=switch,"false","true",tag=PRGG, desc=PRGG
PRRK=switch,"false","true",tag=PRRK, desc=PRRK
PRDRD=switch,"false","true",tag=PRDRD, desc=PRDRD
PRSCVPT=switch,"false","true",tag=PRSCVPT, desc=PRSCVPT
PRST=switch,"false","true",tag=PRST, desc=PRST
PRRR=switch,"false","true",tag=PRRR, desc=PRRR
HMPR=switch,"false","true",tag=HMPR, desc=HMPR
PRMST=switch,"false","true",tag=PRMST, desc=PRMST
PRCN=switch,"false","true",tag=PRCN, desc=PRCN

