# Script-Hub  —— 由 vendor/loon-plugins/Script-Hub.lpx 自动转换（tools/convert-plugins.mjs）
# 源插件: https://kelee.one/Tool/Loon/Lpx/Script-Hub.lpx
# 请勿手工编辑：改源插件后重新运行 bun tools/fetch-plugins.mjs && bun tools/convert-plugins.mjs

^https?:\/\/script\.hub\/($|edit\/|reload) url script-request-body https://raw.githubusercontent.com/Anymore0010/proxy-profile/master/snapshot/github.com/Script-Hub-Org/Script-Hub/main/script-hub.js
^https?:\/\/script\.hub\/file\/_start_\/.+type=(?:qx-rewrite|surge-module|loon-plugin|all-module) url script-request-body https://raw.githubusercontent.com/Anymore0010/proxy-profile/master/snapshot/github.com/Script-Hub-Org/Script-Hub/main/Rewrite-Parser.js
^https?:\/\/script\.hub\/file\/_start_\/.+type=rule-set url script-request-body https://raw.githubusercontent.com/Anymore0010/proxy-profile/master/snapshot/github.com/Script-Hub-Org/Script-Hub/main/rule-parser.js
^https?:\/\/script\.hub\/convert\/ url script-request-body https://raw.githubusercontent.com/Anymore0010/proxy-profile/master/snapshot/github.com/Script-Hub-Org/Script-Hub/main/script-converter.js

hostname = script.hub, *.script.hub
