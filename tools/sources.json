      "host, yimuapp.com, direct",
      "host-suffix, lty01.com, 全球手动策略",
      "host, resolver.msg.xiaomi.net, direct",
      "host-suffix, aptvpn.org, 全球手动策略",
      "host-suffix, tokenharbor.ai, 新国手动策略",
      "host-suffix, discord.com, 全球手动策略",
      "host-suffix, b.ai, 全球手动策略",
      "host-suffix, youmind.com, 全球手动策略",
      "host-suffix, perchai.app, 全球手动策略",
      "host-keyword, missav, 全球手动策略",
