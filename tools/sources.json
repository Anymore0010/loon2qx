  "local_rules": {
    "_comment": "Verbatim port of Loon's [Rule] section. Loon DOMAIN/DOMAIN-SUFFIX/DOMAIN-KEYWORD map to QX host/host-suffix/host-keyword, and DIRECT maps to direct.",
