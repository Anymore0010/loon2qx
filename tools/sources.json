{
  "_comment": "Single source of truth for every external resource used by the Quantumult X profile. tools/build.mjs generates QuantumultX/loon2qx.conf from this file; tools/fetch-snapshot.mjs mirrors every url into snapshot/ and generates the offline profile. Do not edit the generated .conf files by hand.",
  "_origin": "Converted from the Loon profile in loon_config/ (see MAPPING.md for the plugin-by-plugin rationale).",

  "general": {
    "profile_img_url": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/QuantumultX.png",
    "resource_parser_url": "https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/resource-parser.js",
    "network_check_url": "http://connectivitycheck.platform.hicloud.com/generate_204",
    "server_check_url": "http://www.gstatic.com/generate_204",
    "server_check_timeout": 2000,
    "geo_location_checker": "http://ip-api.com/json/?lang=zh-CN, https://raw.githubusercontent.com/KOP-XIAO/QuantumultX/master/Scripts/server-info-plus.js",
    "dns_exclusion_list": "*.cmpassport.com, *.jegotrip.com.cn, *.icitymobile.mobi, id6.me",
    "excluded_routes": "10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 255.255.255.255/32",
    "fallback_udp_policy": "reject"
  },

  "dns": {
    "_comment": "From Loon [General] doh-server. ip-mode=dual means IPv6 stays enabled, so no-ipv6 is deliberately NOT set.",
    "doh_server": [
      "https://dns.alidns.com/dns-query",
      "https://doh.pub/dns-query",
      "https://dns.google/dns-query"
    ]
  },

  "policies": {
    "_comment": "Loon's [Remote Filter] node sets become url-latency-benchmark policies; Loon's [Proxy Group] selects become static policies on top of them. Regexes are carried over verbatim from the Loon profile.",
    "regions": [
      {
        "name": "香港节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/HK.png",
        "regex": "^(?=.*((?i)🇭🇰|香港|(\\b(HK|Hong)(\\d+)?\\b)))(?!.*((?i)回国|校园|游戏|🎮|(\\b(GAME)\\b))).*$"
      },
      {
        "name": "台湾节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/TW.png",
        "regex": "^(?=.*((?i)🇹🇼|台湾|(\\b(TW|Tai|Taiwan)(\\d+)?\\b)))(?!.*((?i)回国|校园|游戏|🎮|(\\b(GAME)\\b))).*$"
      },
      {
        "name": "日本节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/JP.png",
        "regex": "^(?=.*((?i)🇯🇵|日本|川日|东京|大阪|泉日|埼玉|(\\b(JP|Japan)(\\d+)?\\b)))(?!.*((?i)回国|校园|游戏|🎮|(\\b(GAME)\\b))).*$"
      },
      {
        "name": "韩国节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/KR.png",
        "regex": "^(?=.*((?i)🇰🇷|韩国|韓|首尔|(\\b(KR|Korea)(\\d+)?\\b)))(?!.*((?i)回国|校园|游戏|🎮|(\\b(GAME)\\b))).*$"
      },
      {
        "name": "新国节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/SG.png",
        "regex": "^(?=.*((?i)🇸🇬|新加坡|狮|(\\b(SG|Singapore)(\\d+)?\\b)))(?!.*((?i)回国|校园|游戏|🎮|(\\b(GAME)\\b))).*$"
      },
      {
        "name": "美国节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/US.png",
        "regex": "^(?=.*((?i)🇺🇸|美国|波特兰|达拉斯|俄勒冈|凤凰城|费利蒙|硅谷|拉斯维加斯|洛杉矶|圣何塞|圣克拉拉|西雅图|芝加哥|(\\b(US|United States)(\\d+)?\\b)))(?!.*((?i)回国|校园|游戏|🎮|(\\b(GAME)\\b))).*$"
      },
      {
        "name": "游戏节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/GAME.png",
        "regex": "^(?=.*((?i)游戏|🎮|(\\b(GAME)(\\d+)?\\b)))(?!.*((?i)回国|校园)).*$"
      },
      {
        "name": "全球节点",
        "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/Global.png",
        "regex": "^(?=.*(.))(?!.*((?i)群|邀请|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|无法|说明|使用|提示|特别|访问|支持|(\\b(USE|USED|TOTAL|EXPIRE|EMAIL|Panel)\\b|(\\d{4}-\\d{2}-\\d{2}|\\dG)))).*$"
      }
    ],
    "selects": [
      { "name": "全球手动策略", "region": "全球节点" },
      { "name": "香港手动策略", "region": "香港节点" },
      { "name": "新国手动策略", "region": "新国节点" },
      { "name": "日本手动策略", "region": "日本节点" },
      { "name": "韩国手动策略", "region": "韩国节点" },
      { "name": "美国手动策略", "region": "美国节点" },
      { "name": "游戏手动策略", "region": "游戏节点" },
      { "name": "台湾手动策略", "region": "台湾节点" }
    ]
  },

